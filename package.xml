<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mono_depth_viewer</name>
  <version>0.1.1</version>
  <description>Qt viewer that runs transformer-based monocular depth estimation on image topics stored in ROS 2 bags.</description>
  <maintainer email="n.divagar18@gmail.com">Divagar</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/divagarn/mono_depth_ros2</url>
  <url type="repository">https://github.com/divagarn/mono_depth_ros2</url>
  <url type="bugtracker">https://github.com/divagarn/mono_depth_ros2/issues</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <!-- torch and transformers have no rosdep keys: install with `pip install -r requirements.txt` -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
